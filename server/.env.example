PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=change_this_to_a_long_random_secret

# Rate limiting (all optional; the defaults below are used when a line is missing)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_API_MAX=600            RATE_LIMIT_API_WINDOW_MIN=15
# RATE_LIMIT_LOGIN_MAX=10           RATE_LIMIT_LOGIN_WINDOW_MIN=15
# RATE_LIMIT_REGISTER_MAX=10        RATE_LIMIT_REGISTER_WINDOW_MIN=60
# RATE_LIMIT_INVITE_MAX=20          RATE_LIMIT_INVITE_WINDOW_MIN=60
# RATE_LIMIT_PROFILE_MAX=20         RATE_LIMIT_PROFILE_WINDOW_MIN=60
